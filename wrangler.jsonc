{
  // Cloudflare settings for Scout Campsite Finder. See SETUP.md.
  // Fill in the three PASTE_… values during setup. Never put passwords in this file: they go in as Cloudflare "secrets".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scout-campsite-finder",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "kv_namespaces": [
    // made by: npx wrangler kv namespace create SITES   (paste the id it prints)
    { "binding": "SITES", "id": "PASTE_KV_ID_HERE" }
  ],
  // rebuild the list every 10 minutes (only saves when something changed)
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    // where the map's list comes from: "sheet" (the Google Sheet) or "google" (a shared Google Maps list)
    "LIST_SOURCE": "sheet",
    // optional: the ID of a shared Google Maps list whose new places should arrive in the Sheet as Pending.
    // It's the part after /placelists/list/ in the list's link. Leave "" to switch this off.
    "GOOGLE_LIST_ID": "",
    // public Turnstile site key ("I'm human" check) from the Cloudflare dashboard
    "TURNSTILE_SITE_KEY": "PASTE_TURNSTILE_SITE_KEY_HERE",
    // the Google Apps Script web app address (ends in /exec)
    "APPS_SCRIPT_URL": "PASTE_APPS_SCRIPT_URL_HERE"
  }
  // secrets (never in this file): npx wrangler secret put APPS_SCRIPT_SECRET / REFRESH_SECRET / TURNSTILE_SECRET
}
